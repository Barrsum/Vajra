[gd_scene load_steps=9 format=3]

; GDQuest's camera rig node-for-node (transforms copied verbatim — the feel
; lives in these numbers), carrying our Y Bot skin and combat script.

[ext_resource type="Script" path="res://scripts/hero.gd" id="1_hero"]
[ext_resource type="Script" path="res://player/camera_controller.gd" id="2_cam"]
[ext_resource type="PackedScene" path="res://assets/character/ybot.fbx" id="3_model"]
[ext_resource type="AnimationLibrary" path="res://assets/character/player_anims.res" id="4_anims"]
[ext_resource type="AnimationNodeStateMachine" path="res://assets/character/player_tree.tres" id="5_tree"]

[sub_resource type="CapsuleShape3D" id="ShapeBody"]
radius = 0.35
height = 1.8

[sub_resource type="SeparationRayShape3D" id="ShapeSpring"]
length = 0.2

[sub_resource type="CylinderShape3D" id="ShapeGround"]
height = 0.2
radius = 0.4

[node name="Hero" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_hero")

[node name="CharacterCollisionShape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("ShapeBody")

[node name="CameraController" type="Node3D" parent="."]
; top_level detaches the rig from the body — the script positions it itself.
; The tilt limits MUST be overridden: the script's defaults are (-60, 60) and it
; calls clamp(x, lower, upper), which with those values pins pitch to +60 and
; aims the camera at the sky.
top_level = true
script = ExtResource("2_cam")
invert_mouse_y = true
tilt_upper_limit = 0.48
tilt_lower_limit = -0.8

[node name="CameraOverShoulderPivot" type="Marker3D" parent="CameraController"]
transform = Transform3D(-0.994522, 0.0400013, -0.0965717, 0, 0.92388, 0.382683, 0.104528, 0.380587, -0.918818, -0.848491, 3.48765, -2.32639)

[node name="CameraSpringArm" type="SpringArm3D" parent="CameraController"]
transform = Transform3D(-1, -5.15034e-15, -8.74228e-08, -3.23484e-08, 0.929023, 0.370022, 8.12178e-08, 0.370022, -0.929023, 0, 2.33984, 0)
collision_mask = 1
shape = SubResource("ShapeSpring")
spring_length = 10.0
margin = 0.1

[node name="CameraThirdPersonPivot" type="Marker3D" parent="CameraController/CameraSpringArm"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 10)

[node name="PlayerCamera" type="Camera3D" parent="CameraController"]
transform = Transform3D(-1, -3.71248e-14, -8.74228e-08, -3.23484e-08, 0.929023, 0.370022, 8.12178e-08, 0.370022, -0.929023, -8.74228e-07, 6.04006, -9.29023)
top_level = true
fov = 50.0
near = 0.1
far = 400.0

[node name="CameraRayCast" type="RayCast3D" parent="CameraController/PlayerCamera"]
target_position = Vector3(0, 0, -100)
collision_mask = 1

[node name="GroundShapeCast" type="ShapeCast3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
shape = SubResource("ShapeGround")
target_position = Vector3(0, -2.6, 0)
margin = 0.5
collision_mask = 1

[node name="CharacterRotationRoot" type="Node3D" parent="."]

[node name="Model" parent="CharacterRotationRoot" instance=ExtResource("3_model")]

[node name="AnimationPlayer" type="AnimationPlayer" parent="CharacterRotationRoot"]
root_node = NodePath("../Model")
libraries = {
&"": ExtResource("4_anims")
}

[node name="AnimationTree" type="AnimationTree" parent="CharacterRotationRoot"]
tree_root = ExtResource("5_tree")
anim_player = NodePath("../AnimationPlayer")
active = true
